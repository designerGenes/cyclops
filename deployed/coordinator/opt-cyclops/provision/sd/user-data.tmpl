#cloud-config
# Cyclops eye — zero-touch first boot. Generated by make_eye_sdcard.sh.
# The #cloud-config header above is MANDATORY (cloud-init ignores the
# file without it).

hostname: __NODE_NAME__
manage_etc_hosts: true
timezone: __TIMEZONE__

# Keys-only SSH for the MacBook that built this card.
users:
  - name: __SSH_USER__
    groups: users,adm,dialout,audio,netdev,video,plugdev,gpio,spi,i2c,sudo
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - __SSH_PUBKEY__

enable_ssh: true
ssh_pwauth: false

# The payload (camnode source, installer, secrets) was written to the
# boot partition under cyclops/. runcmd hands off to firstboot.sh, which
# does the heavy lifting and reboots once at the end.
runcmd:
  - [ bash, /boot/firmware/cyclops/firstboot.sh ]
